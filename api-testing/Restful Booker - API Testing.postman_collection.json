  "item": [
    {
      "name": "POST - Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Login returns status 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Login returns a valid token\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.token).to.be.a(\"string\");\r\n    pm.expect(data.token.length).to.be.greaterThan(0);\r\n});\r\n\r\n\r\nif (pm.response.code === 200) {\r\n    const loginData = pm.response.json();\r\n\r\n    if (loginData.token) {\r\n        pm.collectionVariables.set(\"authToken\", loginData.token);\r\n    }\r\n}\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://automationintesting.online/api/auth/login",
          "protocol": "https",
          "host": [
            "automationintesting",
            "online"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "POST - Invalid Admin Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Invalid login returns 401\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"Invalid login returns error message\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.error).to.eql(\"Invalid credentials\");\r\n});\r\n\r\npm.test(\"Invalid login does not return a token\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data).to.not.have.property(\"token\");\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "\r\n{\r\n  \"username\": \"admin\",\r\n  \"password\": \"wrongpassword123\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://automationintesting.online/api/auth/login",
