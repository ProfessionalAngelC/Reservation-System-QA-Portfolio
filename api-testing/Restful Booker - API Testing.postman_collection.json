    {
      "name": "GET - All Rooms",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains a rooms array\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.rooms).to.be.an(\"array\");\r\n    pm.expect(data.rooms.length).to.be.greaterThan(0);\r\n});\r\n\r\npm.test(\"Single, Double, and Suite rooms exist\", function () {\r\n    const data = pm.response.json();\r\n    const roomTypes = data.rooms.map(room => room.type);\r\n\r\n    pm.expect(roomTypes).to.include(\"Single\");\r\n    pm.expect(roomTypes).to.include(\"Double\");\r\n    pm.expect(roomTypes).to.include(\"Suite\");\r\n});\r\n\r\npm.test(\"Rooms have valid IDs and prices\", function () {\r\n    const data = pm.response.json();\r\n\r\n    data.rooms.forEach(room => {\r\n        pm.expect(room.roomid).to.be.a(\"number\");\r\n        pm.expect(room.roomPrice).to.be.a(\"number\");\r\n        pm.expect(room.roomPrice).to.be.greaterThan(0);\r\n    });\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://automationintesting.online/api/room/",
          "protocol": "https",
          "host": [
            "automationintesting",
            "online"
          ],
          "path": [
            "api",
            "room",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Bookings by Room",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains bookings\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.bookings.length).to.be.above(0);\r\n});\r\n\r\npm.test(\"Booking belongs to room 1\", function () {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.bookings[0].roomid).to.eql(1);\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{authToken}}"
          }
        ],
        "url": {
          "raw": "https://automationintesting.online/api/booking/?roomid=1",
          "protocol": "https",
          "host": [
            "automationintesting",
            "online"
          ],
          "path": [
            "api",
            "booking",
            ""
          ],
          "query": [
            {
              "key": "roomid",
              "value": "1"
            }
          ]
        }
      },
      "response": []
