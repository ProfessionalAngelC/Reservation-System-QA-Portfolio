    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Booking created successfully\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r\n});\r\n\r\nif (pm.response.code === 200 || pm.response.code === 201) {\r\n    const data = pm.response.json();\r\n\r\n    pm.expect(data.bookingid).to.be.a(\"number\");\r\n\r\n    pm.collectionVariables.set(\"bookingId\", data.bookingid);\r\n}\r\n"
            ]
          }
        }
      ],
